# SimonBot — server environment
#
# Copy to `.env` in this folder and fill in what you use. Everything is
# optional: a platform with no credentials simply stays disconnected.
#
# None of these ever reach the browser.

# ---- server
PORT=8081
HOST=0.0.0.0
LOG_LEVEL=info
# Reconnect platforms automatically on boot using stored credentials.
AUTO_START=true

# ---- twitch
# Going-live alerts only: nobody signs in. Create an app at
# https://dev.twitch.tv/console/apps (client type Confidential), then copy its
# Client ID and its Client Secret (New Secret).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- youtube
# Going-live alerts only: nobody signs in. An API key from
# https://console.cloud.google.com/apis/credentials, with the YouTube Data API
# v3 enabled. Checking 50 videos costs 1 of the 10,000 units a day.
YOUTUBE_API_KEY=

# ---- discord
# https://discord.com/developers/applications
# The bot needs the SERVER MEMBERS and MESSAGE CONTENT privileged intents.
# Its OAuth2 redirect is the dashboard's address, for sign-in with Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
